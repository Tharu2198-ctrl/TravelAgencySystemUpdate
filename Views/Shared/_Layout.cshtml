<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Travel Agency</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand" href="/">Travel Agency</a>

            <div class="navbar-nav ms-auto">
                <a class="nav-link text-white" href="/">Home</a>
                <a class="nav-link text-white" href="/Package">Packages</a>
                <a class="nav-link text-white" href="/Home/Destinations">Destinations</a>
                <a class="nav-link text-white" href="/Home/Contact">Contact</a>
            </div>
            <!-- LOGIN -->
            <a class="btn btn-primary btn-sm me-2" href="/Account/Login">
                Login
            </a>

            <!-- REGISTER -->
            <a class="btn btn-success btn-sm" href="/Account/Register">
                Register
            </a>

            <!-- ADMIN -->
            <a class="btn btn-dark btn-sm" href="/Account/AdminLogin">
                Admin
            </a>

        </div>
    </nav>

    <div class="container mt-4">
        @RenderBody()
    </div>

    <footer class="bg-dark text-white mt-5">

        <div class="container py-4">

            <div class="row">

                <!-- ABOUT -->
                <div class="col-md-4 mb-3">

                    <h5 class="text-warning">Travel Agency</h5>

                    <p>
                        Explore the world with our amazing vacation packages
                        and travel destinations.
                    </p>

                </div>

                <!-- QUICK LINKS -->
                <div class="col-md-4 mb-3">

                    <h5 class="text-info">Quick Links</h5>

                    <ul class="list-unstyled">

                        <li>
                            <a href="/" class="text-white text-decoration-none">
                                Home
                            </a>
                        </li>

                        <li>
                            <a href="/Package" class="text-white text-decoration-none">
                                Packages
                            </a>
                        </li>

                        <li>
                            <a href="/Home/Destinations" class="text-white text-decoration-none">
                                Destinations
                            </a>
                        </li>

                        <li>
                            <a href="/Home/Contact" class="text-white text-decoration-none">
                                Contact
                            </a>
                        </li>

                    </ul>

                </div>

                <!-- CONTACT INFO -->
                <div class="col-md-4 mb-3">

                    <h5 class="text-success">Contact Us</h5>

                    <p>Email: info@travelagency.com</p>

                    <p>Phone: +94 71 234 5678</p>

                    <p>Location: Kurunegala, Sri Lanka</p>

                </div>

            </div>

            <hr class="bg-light" />

            <!-- COPYRIGHT -->
            <div class="text-center">

                <p class="mb-0">
                    © 2026 Travel Agency System | All Rights Reserved
                </p>

            </div>

        </div>

    </footer>

</body>
</html>