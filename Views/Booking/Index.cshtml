@model List<TravelAgencySystem.Models.Booking>

<h2>All Bookings</h2>

<!-- ✅ ADD ADMIN BUTTON HERE -->
@if (Context.Session.GetString("Role") == "Admin")
{
    <a href="/Admin/AdminDashboard" class="btn btn-dark mb-3">
        Admin Panel
    </a>
}

<table class="table table-bordered">

    <tr>
        <th>Customer</th>
        <th>Package</th>
        <th>Date</th>
        <th>People</th>
    </tr>

    @foreach (var b in Model)
    {
        <tr>
       <!--  @*   <td>@b.Customer.FullName</td>
            <td>@b.Package.PackageName</td>
            <td>@b.BookingDate</td>
                 <td>@b.NumberOfPeople</td> *@ -->
            <td>@(b.Customer?.FullName ?? "N/A")</td>
            <td>@(b.Package?.PackageName ?? "N/A")</td>
            <td>@b.BookingDate</td>
            <td>@b.NumberOfPeople</td>
        </tr>
    }

</table>