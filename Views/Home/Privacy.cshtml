@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container mt-4">

    <div class="p-4 bg-light rounded shadow-sm">

        <h1 class="text-primary">Privacy Policy</h1>

        <p>
            Welcome to our Travel Agency System. Your privacy is important to us.
            This page explains how we collect, use, and protect your information.
        </p>

        <hr />

        <h4>1. Information We Collect</h4>
        <ul>
            <li>Name and contact details (when booking or contacting us)</li>
            <li>Email address</li>
            <li>Booking information</li>
        </ul>

        <h4>2. How We Use Information</h4>
        <ul>
            <li>To process bookings</li>
            <li>To improve our services</li>
            <li>To communicate with customers</li>
        </ul>

        <h4>3. Data Protection</h4>
        <p>
            We use secure systems and database encryption to protect your personal data stored in MySQL database.
        </p>

        <h4>4. Third-Party Sharing</h4>
        <p>
            We do not sell or share your personal data with third parties without your consent.
        </p>

        <h4>5. Cookies</h4>
        <p>
            Our website may use cookies to improve user experience.
        </p>

        <hr />

        <p class="text-muted">
            Last updated: 2026
        </p>

    </div>

</div>